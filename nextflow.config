/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    cdcent/oamd-bio-qqq Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null

    // Fastp trimming option
    skip_fastp = false

    // Dehosting options
    //
    // Build the index from this FASTA rather than using a prebuilt one. Shared
    // by every dehoster: each builds the index its own tool needs, so the same
    // reference can be used whichever one is selected. Mainly for the test
    // profiles, which build from a tiny genome rather than hosting binaries.
    host_fasta                 = null

    // deacon: a single-file minimizer index.
    deacon_db                  = null             // path to a deacon .idx file

    // hostile and hostess: a directory of bowtie2 index parts, plus its name.
    hostile_db                 = null             // path to hostile reference database directory
    hostile_index              = 'human-t2t-hla.argos-bacteria-985_rs-viral-202401_ml-phage-202401'  // masked human reference excluding pathogen regions
    // Samples whose reads exceed this total size are routed to a larger-resourced
    // copy of the dehoster. Every dehoster uses it, including deacon; the param
    // is named for hostile because that is what it was added for, the way
    // hostile_index is.
    //
    // It is a two-bucket routing decision rather than a scaling factor, but the
    // two families reach that shape from opposite directions. HOSTILE_CLEAN and
    // HOSTESS are routed on memory, which plateaus rather than tracking input
    // size. DEACON_FILTER is routed on CPU, which does track it — the module
    // compresses each mate with its own bgzip, and that work scales with the
    // sample where deacon's filtering barely does. deacon's memory is flat
    // across both tiers.
    hostile_large_input_bytes  = 1_000_000_000    // 1 GB of reads per sample

    // Which dehoster to run.
    //
    // deacon is the default. It matches minimizers against a prebuilt index
    // instead of aligning, which makes it far faster than the other two, and
    // is correspondingly approximate. It keeps no removed reads, so host_bam
    // has no effect under it.
    //
    // hostess aligns, and reads the alignment stream once so it can keep the
    // removed reads as a sorted BAM. hostile applies the same method but
    // cannot produce that BAM without a second alignment pass.
    //
    // 'none' turns host removal off, reducing the pipeline to its minimum:
    // optional bam2fq conversion, falco, and multiqc. No host index is needed
    // in that case, so every option above is ignored.
    dehoster                   = 'deacon'         // 'deacon', 'hostess', 'hostile' or 'none'
    // Keeping the removed reads is on by default: it is the reason hostess
    // exists, and an over-aggressive index is otherwise invisible in the
    // counts. Only hostess produces them — hostile needs a second alignment
    // pass, and deacon never aligns at all.
    host_bam                   = true             // keep removed reads as a sorted BAM (hostess only)

    // Ribosomal RNA depletion options (applied after dehosting, before downsampling)
    //
    // Off unless rrna_ref names a FASTA. There is no built-in default: depleting
    // against nothing would look like success. The reference may be as redundant
    // as it likes — bbduk matches k-mers, so redundancy helps rather than hurts.
    //
    // The reference AMDP publishes is
    //   s3://amdp-prd-analysis-static-assets/bbduk/silva138.2-ssu-lsu-nr99_rfam15.1-5s_20261020/
    // SILVA 138.2 SSU+LSU Ref NR99 truncated exports plus Rfam 15.1 5S,
    // U->T converted, 1,200,640 records. On an un-depleted total-RNA wastewater
    // library it removes 95.75% at 0.16% false positives on non-ribosomal
    // genomic 150-mers. Its README.md records how it was built, what was left
    // out and why, and what the per-record outputs may be read as.
    //
    // Calibrate the expected rate to the prep: ~95% is right for un-depleted
    // total RNA, single digits to ~15% for a bench-depleted RNA library, and
    // ~0.5% for DNA. A rate far outside the range for the stated prep is a
    // sample-identity signal, not a tuning problem.
    rrna_ref                   = null             // path to an rRNA FASTA; null turns the step off
    // k is the only setting that matters. Measured on a wastewater RNA library:
    // k=25 is 99.4% sensitive on known rRNA at 0.07-0.16% false positives on
    // non-ribosomal genomic 150-mers; k=31 costs 2.4-3.1 points of sensitivity
    // and k=21 buys 0.2 points for 2.6x the false positives.
    rrna_k                     = 25

    // Downsampling options (applied after dehosting)
    // Samples with more than max_reads reads (single-end) or read pairs
    // (paired-end) are downsampled to that cap with fadso; smaller samples pass
    // through untouched. Set to null or 0 to disable downsampling entirely.
    max_reads                  = null
    downsample_seed            = 42               // fixed seed, so downsampling is reproducible across runs

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test         { includeConfig 'conf/test.config'         }
    test_hostile { includeConfig 'conf/test_hostile.config' }
    test_full    { includeConfig 'conf/test_full.config'    }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load cdcent/oamd-bio-qqq custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// ph-core configs (AMDP tiers, containers, static assets, resource labels) are
// not loaded from raw.githubusercontent.com: oamd-bio-nf-configs is private, so
// those URLs 404. They are loaded at runtime from a local checkout instead:
//   -c ../oamd-bio-nf-configs/conf/pipeline/custom.config
// See docs/usage.md. This matches the talos pattern.

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'


// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

// Plain interpolation, deliberately, despite a known limitation.
//
// `outdir` is a required param with no default, so this resolves while it is
// still null whenever outdir arrives from a `-c` file rather than the command
// line, and these four reports land in ./null/pipeline_info/. Passing --outdir
// on the command line -- what both launchers in oamd-bio-nf-configs do, and what
// the nf-core docs tell users to do -- resolves it correctly.
//
// The limitation is kept because every alternative measured worse:
//
//   form                        25.10 --outdir  25.10 -c   26.04 --outdir  26.04 -c
//   "${params.outdir}/..."      ok              ./null/    ok              ./null/
//   { "${params.outdir}/..." }  broken          broken     broken          broken
//   "${-> params.outdir}/..."   ok              ok         ok              parse error
//
// The closure form is the trap: Nextflow does not evaluate closures for
// timeline/report/trace/dag `file`, it stringifies the closure object and uses
// that as the path, so the reports are never written and the launch directory
// fills with files named `_nf_config_...$_closure27@3dc82e6a` instead. It fails
// silently -- the run still reports success.
//
// The lazy form is correct on 25.10 but is a config parse error under the
// Nextflow 26.04 parser, which is the version this pipeline is being moved onto.
// No single form is correct on 26.04 for both outdir sources, so this keeps the
// one that is correct for the documented way of passing outdir.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'cdcent/oamd-bio-qqq'
    contributors    = [
        [
            name: 'James Smagala',
            affiliation: 'Office of Advanced Molecular Detection, CDC',
            email: 'gpa1@cdc.gov',
            github: 'smagala',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/cdcent/oamd-bio-qqq'
    description     = """OAMD bioinformatics pipeline qqq"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.0'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.3' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    // Params injected at runtime by the oamd-bio-nf-configs layer (AMDP tier,
    // registry, static assets). They are not pipeline parameters, so they are
    // not in nextflow_schema.json and nf-schema would warn about each one on
    // every production run. "genomes" came from the removed iGenomes config.
    defaultIgnoreParams = [
        "container_org",
        "pipeline_config_path",
        "pipeline_repo_name",
        "pipeline_version",
        "static_assets",
        "tier",
        "current_user",
        "aws_accounts",
        "custom_config_base",
    ]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
