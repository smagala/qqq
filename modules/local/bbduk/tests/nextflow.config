/*
 * The pipeline's conf/modules.config names outputs "<id>_<platform>", and the
 * test meta has no platform, so without this every output would be
 * "test_null.*". How the pipeline names files is the pipeline's test to make,
 * not the module's.
 */
process {
    withName: 'BBDUK' {
        ext.prefix = null
    }
}
