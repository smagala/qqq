/*
 * The pipeline's conf/modules.config names outputs "<id>_<platform>", and the
 * module's own test meta has no platform, so without this every output would be
 * "test_null.*". How the pipeline names files is the pipeline's test to make,
 * not the module's. Not part of the installed module.
 */
process {
    withName: 'BBMAP_BBDUK' {
        ext.prefix = null
    }
}
