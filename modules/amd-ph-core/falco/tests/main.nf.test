
nextflow_process {

    name "Test Process FALCO"
    script "../main.nf"
    process "FALCO"

    tag "modules"
    tag "modules_amdphcore"
    tag "falco"

    test("sarscov2 - fastq - single_end") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true, platform:'illumina', run:1 ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },

                // Verify that filenames match the configured prefix.
                { assert process.out.txt[0][1] ==~ ".*/test_illumina_run1_fastqc_data.txt" },
                { assert process.out.html[0][1] ==~ ".*/test_illumina_run1_fastqc_report.html" },

                { assert snapshot(
                    process.out.txt,
                    process.out.summary,
                    process.out.versions_falco
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired_end") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false, platform:'illumina', run:1 ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },

                // Paired-end reads must produce separate R1 and R2 files.
                { assert process.out.txt[0][1].size() == 2 },
                { assert process.out.txt[0][1][0] ==~ ".*/test_illumina_run1_R1_fastqc_data.txt" },
                { assert process.out.txt[0][1][1] ==~ ".*/test_illumina_run1_R2_fastqc_data.txt" },

                { assert snapshot(
                    process.out.txt,
                    process.out.summary,
                    process.out.versions_falco
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - single_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true, platform:'illumina', run:1 ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },

                // Stub filenames must match real FALCO filenames.
                { assert process.out.txt[0][1] ==~ ".*/test_illumina_run1_fastqc_data.txt" },
                { assert process.out.html[0][1] ==~ ".*/test_illumina_run1_fastqc_report.html" },

                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false, platform:'illumina', run:1 ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },

                // Stub outputs must use the same R1/R2 naming convention.
                { assert process.out.txt[0][1].size() == 2 },
                { assert process.out.txt[0][1][0] ==~ ".*/test_illumina_run1_R1_fastqc_data.txt" },
                { assert process.out.txt[0][1][1] ==~ ".*/test_illumina_run1_R2_fastqc_data.txt" },

                { assert snapshot(process.out).match() }
            )
        }
    }
}
