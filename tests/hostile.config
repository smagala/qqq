/*
========================================================================================
    Overrides the test profile's dehoster for the hostile pipeline test
========================================================================================
    nf-test runs every test under the `test` profile (see nf-test.config), which
    leaves the dehoster at the pipeline default of deacon. This switches that one
    test to hostile so the aligning path keeps its coverage. Everything else about
    the run — input, host_fasta, resource limits — stays as the test profile sets it.
*/

params.dehoster = 'hostile'
