nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/qqq_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    //
    // deacon is the default and is what the test profile above covers. This
    // runs the same data through the aligning path instead, so BOWTIE2_BUILD,
    // the size-routed HOSTILE_CLEAN tiers and the array-shaped hostile report
    // keep their coverage now that they are no longer the default. The two
    // dehosters write their read counts under different names and in different
    // JSON shapes, and the workflow reduces both to the same two General
    // Statistics columns — a snapshot of each is what checks that.
    //
    test("-profile test, --dehoster hostile") {
        config "tests/hostile.config"
        when {
            params {
                outdir = "$outputDir"
                }
            }
        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/qqq_software_mqc_versions.yml"),
                    stable_path,
                    stable_content
                    ).match() }
                )
            }
        }
    test("-profile test, --skip_fastp") {
        when {
        params {
            outdir = "$outputDir"
            skip_fastp = true
            dehoster = "none"
            }
        }
    then {
        assert workflow.success
        def stable_path = getAllFilesFromDir(
            params.outdir,
            relative: true,
            includeDir: true,
            ignore: ['pipeline_info/*.{html,json,txt}']
            )
        assert stable_path.any {
            it.toString().contains(".merged.fastq.gz")
            }
        assert !stable_path.any {
            it.toString().contains(".fastp.json")
            }
        assert snapshot(stable_path).match()
        }
    }
}
