nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                rrna_ref = null    // assumes rRNA depletion off; CI loads nf-configs, which turns it on, and test params outrank it
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            // Every published path the run report gives must exist in the outdir.
            // This is what keeps the directories workflows/qqq.nf writes into the
            // report in step with the publishDir rules in conf/modules.config.
            def report = path("${params.outdir}/run_report/qqq_run_report.json").json
            def published = []
            def walk
            walk = { node ->
                if (node instanceof Map) {
                    if (node.containsKey('relative_path')) {
                        published << node.path
                    }
                    node.values().each { v -> walk(v) }
                }
                else if (node instanceof List) {
                    node.each { v -> walk(v) }
                }
            }
            walk(report)
            def test_illumina = report.samples.find { s -> s.id == 'test_illumina' }
            assertAll(
                { assert published.size() > 0 },
                { assert published.findAll { p -> !new File(p.toString()).exists() } == [] },
                { assert report.samples*.id == ['test2_illumina', 'test_illumina', 'test_long_nanopore'] },
                // Two runs merged into one sample: the read filter sums over both, and
                // the counts chain into host removal without a gap.
                { assert test_illumina.steps.read_filter.runs.size() == 2 },
                { assert test_illumina.steps.host_removal.input_reads == test_illumina.steps.read_filter.output_reads },
                { assert test_illumina.outputs.clean_reads.files*.relative_path == ['deacon/test_illumina.clean_1.fq.gz', 'deacon/test_illumina.clean_2.fq.gz'] },
                { assert test_illumina.outputs.removed_reads.read_filter.files.size() == 6 },
                { assert test_illumina.outputs.removed_reads.host_removal.reason == 'host reads not retained (deacon/hostile keep none)' },
                { assert report.samples.every { s -> s.warnings == [] } },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/qqq_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    //
    // deacon is the default and is what the test profile above covers. This
    // runs the same data through the aligning path instead, so BOWTIE2_BUILD,
    // the size-routed HOSTILE_CLEAN tiers and the array-shaped hostile report
    // keep their coverage now that they are no longer the default. The two
    // dehosters write their read counts under different names and in different
    // JSON shapes, and the workflow reduces both to the same two General
    // Statistics columns — a snapshot of each is what checks that.
    //
    test("-profile test, --dehoster hostile") {
        config "tests/hostile.config"
        when {
            params {
                outdir = "$outputDir"
                rrna_ref = null    // assumes rRNA depletion off; CI loads nf-configs, which turns it on, and test params outrank it
                }
            }
        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            // Every published path the run report gives must exist in the outdir.
            // This is what keeps the directories workflows/qqq.nf writes into the
            // report in step with the publishDir rules in conf/modules.config.
            def report = path("${params.outdir}/run_report/qqq_run_report.json").json
            def published = []
            def walk
            walk = { node ->
                if (node instanceof Map) {
                    if (node.containsKey('relative_path')) {
                        published << node.path
                    }
                    node.values().each { v -> walk(v) }
                }
                else if (node instanceof List) {
                    node.each { v -> walk(v) }
                }
            }
            walk(report)
            assertAll(
                { assert published.findAll { p -> !new File(p.toString()).exists() } == [] },
                // hostile's array-shaped report reaches the same fields deacon's does.
                { assert report.samples.every { s -> s.steps.host_removal.tool == 'hostile' && s.steps.host_removal.input_reads > 0 } },
                { assert report.samples.every { s -> s.outputs.clean_reads.step == 'host_removal' && s.outputs.clean_reads.files[0].relative_path.startsWith('hostile/') } },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/qqq_software_mqc_versions.yml"),
                    stable_path,
                    stable_content
                    ).match() }
                )
            }
        }
    test("-profile test, --skip_fastp") {
        when {
        params {
            outdir = "$outputDir"
            rrna_ref = null    // assumes rRNA depletion off; CI loads nf-configs, which turns it on, and test params outrank it
            skip_fastp = true
            dehoster = "none"
            }
        }
    then {
        assert workflow.success
        def stable_path = getAllFilesFromDir(
            params.outdir,
            relative: true,
            includeDir: true,
            ignore: ['pipeline_info/*.{html,json,txt}']
            )
        assert stable_path.any {
            it.toString().contains(".merged.fastq.gz")
            }
        assert !stable_path.any {
            it.toString().contains(".fastp.json")
            }
        // Nothing rewrites a single-run sample's reads here, so the report must
        // say they were not published rather than invent a path; the merged
        // samples' final reads are the CAT_FASTQ output.
        def report = path("${params.outdir}/run_report/qqq_run_report.json").json
        def test2 = report.samples.find { s -> s.id == 'test2_illumina' }
        def test1 = report.samples.find { s -> s.id == 'test_illumina' }
        assert test2.steps.read_filter.status == 'skipped'
        assert test2.outputs.clean_reads.files == null
        assert test2.outputs.clean_reads.source_files.size() == 2
        assert test1.outputs.clean_reads.files*.relative_path == ['cat/test_illumina_1.merged.fastq.gz', 'cat/test_illumina_2.merged.fastq.gz']
        assert test1.outputs.clean_reads.files.every { f -> new File(f.path.toString()).exists() }
        assert snapshot(stable_path).match()
        }
    }

    //
    // The branch under test is the gate, not the tool: samples above the cap go
    // to rasusa and the rest bypass it on a read count taken from the dehoster's
    // report. A cap of 1000 sits between the test samples — the two Illumina
    // samples dehost to about 267,000 pairs each and the nanopore sample to 515
    // reads — so both sides of the gate fire in one run, which is what separates
    // a working gate from one routing every sample the same way.
    //
    test("-profile test, --max_reads") {
        when {
        params {
            outdir = "$outputDir"
            rrna_ref = null    // assumes rRNA depletion off; CI loads nf-configs, which turns it on, and test params outrank it
            max_reads = 1000
            }
        }
    then {
        assert workflow.success
        def stable_path = getAllFilesFromDir(
            params.outdir,
            relative: true,
            includeDir: true,
            ignore: ['pipeline_info/*.{html,json,txt}']
            )
        def downsampled = stable_path.findAll {
            it.toString().contains(".downsampled.fastq.gz")
            }
        assertAll(
            // Four files: both mates of each of the two Illumina samples.
            { assert downsampled.size() == 4 },
            // The sample under the cap bypassed the module rather than being
            // sampled to its own size, which is the half of the gate a count
            // assertion on the downsampled files alone would not notice.
            { assert !downsampled.any { it.toString().contains("test_long") } },
            // Exactly the cap, from a tool that measured the input first.
            { assert downsampled.every {
                path("${params.outdir}/${it}").linesGzip.size() == 1000 * 4
                } },
            // The report sees the same gate: rasusa's output for the samples over
            // the cap, and "bypassed" with the dehosted reads for the one under it.
            { assert path("${params.outdir}/run_report/qqq_run_report.json").json.samples.collectEntries { s ->
                [ s.id, [ s.steps.downsampling.status, s.outputs.clean_reads.step, s.output_reads ] ]
                } == [
                    test2_illumina    : [ 'ran', 'downsampling', 2000 ],
                    test_illumina     : [ 'ran', 'downsampling', 2000 ],
                    test_long_nanopore: [ 'bypassed', 'host_removal', 515 ],
                ] },
            { assert snapshot(stable_path).match() }
            )
        }
    }

    //
    // rRNA depletion runs ahead of the dehoster. The rRNA reference here is the
    // SARS-CoV-2 transcriptome: it hits the amplicon reads in the test sheet, and
    // the test profile's host is the SARS-CoV-2 genome, so bbduk takes most of
    // them and the dehoster takes what bbduk left -- both steps remove something.
    // Asserts the order end to end: each step's input is the previous step's
    // output in the report, the final reads come from the dehoster, and every
    // path the report names exists. Run under deacon, which drops `route`, and
    // under hostile, whose short/long split needs `route` rejoined after bbduk.
    //
    test("-profile test, --rrna_ref (rRNA depletion before dehosting)") {
        when {
            params {
                outdir   = "$outputDir"
                rrna_ref = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome/transcriptome.fasta'
            }
        }
        then {
            assert workflow.success
            def report = path("${params.outdir}/run_report/qqq_run_report.json").json
            def published = []
            def walk
            walk = { node ->
                if (node instanceof Map) {
                    if (node.containsKey('relative_path')) {
                        published << node.path
                    }
                    node.values().each { v -> walk(v) }
                }
                else if (node instanceof List) {
                    node.each { v -> walk(v) }
                }
            }
            walk(report)
            assertAll(
                { assert report.step_order == ['read_filter', 'rrna_depletion', 'host_removal', 'downsampling'] },
                { assert published.findAll { p -> !new File(p.toString()).exists() } == [] },
                { assert report.samples*.id == ['test2_illumina', 'test_illumina', 'test_long_nanopore'] },
                { assert report.samples.every { s -> s.steps.rrna_depletion.input_reads == s.steps.read_filter.output_reads } },
                { assert report.samples.every { s -> s.steps.host_removal.input_reads == s.steps.rrna_depletion.output_reads } },
                { assert report.samples.every { s -> s.output_reads == s.steps.host_removal.output_reads } },
                { assert report.summary.removed_reads.rrna_depletion > 0 },
                { assert report.summary.removed_reads.host_removal > 0 },
                { assert report.samples.every { s -> s.warnings == [] } },
                { assert report.samples.every { s -> s.outputs.clean_reads.step == 'host_removal' && s.outputs.clean_reads.files[0].relative_path.startsWith('deacon/') } },
                { assert report.samples.every { s -> s.outputs.removed_reads.rrna_depletion.files[0].relative_path.startsWith('bbduk/') } }
            )
        }
    }

    test("-profile test, --dehoster hostile, --rrna_ref") {
        config "tests/hostile.config"
        when {
            params {
                outdir   = "$outputDir"
                rrna_ref = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome/transcriptome.fasta'
            }
        }
        then {
            assert workflow.success
            def report = path("${params.outdir}/run_report/qqq_run_report.json").json
            def long_sample = report.samples.find { s -> s.id == 'test_long_nanopore' }
            assertAll(
                { assert report.samples.every { s -> s.steps.host_removal.tool == 'hostile' } },
                { assert report.samples.every { s -> s.steps.host_removal.input_reads == s.steps.rrna_depletion.output_reads } },
                { assert report.samples.every { s -> s.warnings == [] } },
                // The long-read sample still reaches hostile's minimap2 tier: the
                // short/long split reads `route`, which bbduk does not carry.
                { assert long_sample.outputs.clean_reads.step == 'host_removal' },
                { assert long_sample.outputs.clean_reads.files*.relative_path.every { p -> p.startsWith('hostile/') } }
            )
        }
    }
}
