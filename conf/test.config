/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run cdcent/oamd-bio-qqq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input = "${projectDir}/assets/samplesheet_test.csv"

    // Dehosting
    // Human reads against a SARS-CoV-2 "host" index: nothing should be removed,
    // so the dehosted output is non-empty and the rest of the pipeline gets real
    // data to work with. The index is built from this FASTA at runtime rather
    // than downloaded, because a bowtie2 index is around 8 MB even for a 30 KB
    // genome.
    hostile_fasta = params.pipelines_testdata_base_path + 'modules/data/genomics/sarscov2/genome/genome.fasta'
}
