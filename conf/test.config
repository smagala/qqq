/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run cdcent/oamd-bio-qqq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    // GitHub-hosted runners have 2 CPUs. BOWTIE2_BUILD is process_high, which
    // asks for 12, so a cap above 2 makes Nextflow refuse the task outright
    // with "Process requirement exceeds available CPUs".
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input = "${projectDir}/assets/samplesheet_test.csv"

    // Dehosting
    // Human reads against a SARS-CoV-2 "host" index: nothing should be removed,
    // so the dehosted output is non-empty and the rest of the pipeline gets real
    // data to work with. The index is built from this FASTA at runtime rather
    // than downloaded, because a bowtie2 index is around 8 MB even for a 30 KB
    // genome.
    hostile_fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome/genome.fasta'

    // The pipeline default is hostess, but this profile pins hostile because it
    // is the only dehoster with a publicly pullable image. hostess ships inside
    // the AMDP hostile image, which needs registry credentials, so a run of this
    // profile outside the CDC network could not pull it.
    //
    // The hostess path is covered instead by the module's own nf-test and by
    // running this profile with -c pointing HOSTESS at the internal image.
    dehoster = 'hostile'
}
