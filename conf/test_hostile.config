/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests against the hostile dehoster
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The test profile covers deacon, which is the pipeline default. This one is
    the same test with --dehoster hostile, so the aligning path — BOWTIE2_BUILD,
    the size-routed HOSTILE_CLEAN tiers, and the array-shaped hostile JSON the
    workflow has to read alongside deacon's object-shaped one — keeps its
    coverage now that it is no longer the default.

    hostess is deliberately not covered here: it has no public image.

    Use as follows:
        nextflow run cdcent/oamd-bio-qqq -profile test_hostile,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Hostile test profile'
    config_profile_description = 'Minimal test dataset run against the hostile dehoster'

    dehoster = 'hostile'
}
