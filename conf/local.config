/*
 * Local development config — uses ECR containers directly
 */

docker.registry = '025066257930.dkr.ecr.us-east-1.amazonaws.com'

process {
    resourceLimits = [
        cpus: 8,
        memory: '30.GB',
        time: '4.h'
    ]
}

params {
    hostile_index = "${projectDir}/../assets/hostile"
}
