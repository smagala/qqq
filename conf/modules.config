/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // deacon spreads records across threads and writes them back as they
    // finish, so two runs over the same input return the same reads in a
    // different order — and therefore different files. --ordered restores the
    // input ordering; upstream documents it as deterministic and slightly
    // slower, and it exists only from deacon 0.17.0.
    //
    // Measured on 533k read pairs at two threads: without it, five runs of
    // 0.16.0 produced two distinct outputs, and three runs of 0.17.0 did the
    // same. A dehosted FASTQ is an artefact this pipeline publishes and other
    // work reads, so the same input should give the same bytes. Drop this in
    // the pipeline config to trade reproducibility back for speed.
    // Both size tiers, so the selector has to match the suffixed alias names.
    // withName matches as a full regex, so a bare 'DEACON_FILTER' matches
    // neither DEACON_FILTER_SMALL nor DEACON_FILTER_LARGE and --ordered would
    // be silently dropped from both.
    withName: 'DEACON_FILTER_(SMALL|LARGE)' {
        ext.args = '--ordered'
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HOSTILE_CLEAN_(SMALL|LARGE)_(SHORT|LONG)' {
        ext.args = {
            meta.type == 'long' ? '--aligner minimap2' : '--aligner bowtie2'
            }
        ext.prefix = { "${meta.id}_${meta.platform}" }
    }

    withName: 'FALCO|FASTP|FASTPLONG' {
        ext.prefix = { "${meta.id}_${meta.platform}_run${meta.run}" }
        }

    withName: 'CAT_FASTQ' {
        ext.prefix = { "${meta.id}_${meta.platform}" }
        }

    withName: 'DEACON_FILTER_(SMALL|LARGE)' {
        ext.prefix = { "${meta.id}_${meta.platform}" }
        }

    withName: 'FADSO' {
        ext.prefix = { "${meta.id}_${meta.platform}" }
        }

    // k comes from a param rather than being hardcoded here because it is the
    // one bbduk setting with a measured trade-off behind it; see the schema.
    // `interleaved=f` is explicit: bbduk guesses from read names, and a library
    // whose mates are named identically would otherwise be read as interleaved.
    withName: 'BBMAP_BBDUK' {
        // 8 GB because the k-mer table is sized by the REFERENCE, not by the
        // library -- reads stream, the table is a fixed allocation -- so this
        // does not grow with sample size. Measured on the 1.26 Gbp AMDP rRNA
        // reference: the module asks the JVM for 85% of this, output is
        // bit-identical from -Xmx16g down to -Xmx4g, and -Xmx3g dies with
        // OutOfMemoryError at `Allocating kmer table` before reading a single
        // read. 8 GB leaves about 1 GB of slack and never approached the cap.
        memory     = { 8.GB * task.attempt }
        ext.args   = { "k=${params.rrna_k} interleaved=f" }
        ext.prefix = { "${meta.id}_${meta.platform}" }
        // The default rule above derives the folder from the module family --
        // BBMAP_BBDUK tokenizes on '_' to "bbmap" -- which puts rRNA depletion
        // output in a directory named after a read aligner this pipeline does
        // not run. Every other step here is named for its tool (falco, deacon,
        // fastp), so name this one for its tool too.
        publishDir = [
            path: { "${params.outdir}/bbduk" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        }

    withName: 'HOSTESS_(SMALL|LARGE)_(SHORT|LONG)' {
        ext.args = {
            def aligner = meta.type == 'long' ? '--aligner minimap2' : '--aligner bowtie2'
            "${aligner}${params.host_bam ? ' --bam' : ''}"
            }
            ext.prefix = { "${meta.id}_${meta.platform}" }
            }
}
