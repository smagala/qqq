/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // deacon spreads records across threads and writes them back as they
    // finish, so two runs over the same input return the same reads in a
    // different order — and therefore different files. --ordered restores the
    // input ordering; upstream documents it as deterministic and slightly
    // slower, and it exists only from deacon 0.17.0.
    //
    // Measured on 533k read pairs at two threads: without it, five runs of
    // 0.16.0 produced two distinct outputs, and three runs of 0.17.0 did the
    // same. A dehosted FASTQ is an artefact this pipeline publishes and other
    // work reads, so the same input should give the same bytes. Drop this in
    // the pipeline config to trade reproducibility back for speed.
    // Both size tiers, so the selector has to match the suffixed alias names.
    // withName matches as a full regex, so a bare 'DEACON_FILTER' matches
    // neither DEACON_FILTER_SMALL nor DEACON_FILTER_LARGE and --ordered would
    // be silently dropped from both.
    withName: 'DEACON_FILTER_(SMALL|LARGE)' {
        ext.args = '--ordered'
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HOSTILE_CLEAN_(SMALL|LARGE)_(SHORT|LONG)' {
        ext.args = {
            meta.type == 'long' ? '--aligner minimap2' : '--aligner bowtie2'
            }
        ext.prefix = { "${meta.id}_${meta.platform}" }
    }

    withName: 'FALCO|FASTP|FASTPLONG' {
        ext.prefix = { "${meta.id}_${meta.platform}_run${meta.run}" }
        }

    withName: 'CAT_FASTQ' {
        ext.prefix = { "${meta.id}_${meta.platform}" }
        }

    withName: 'DEACON_FILTER_(SMALL|LARGE)' {
        ext.prefix = { "${meta.id}_${meta.platform}" }
        }

    withName: 'FADSO' {
        ext.prefix = { "${meta.id}_${meta.platform}" }
        }
    
    withName: 'HOSTESS_(SMALL|LARGE)_(SHORT|LONG)' {
        ext.args = {
            def aligner = meta.type == 'long' ? '--aligner minimap2' : '--aligner bowtie2'
            "${aligner}${params.host_bam ? ' --bam' : ''}"
            }
            ext.prefix = { "${meta.id}_${meta.platform}" }
            }
}
